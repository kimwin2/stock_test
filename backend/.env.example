GEMINI_API_KEY=your-gemini-api-key-here
# 키 발급: https://aistudio.google.com/app/apikey
# 모델은 OpenAI SDK 의 base_url 을 Gemini OpenAI-호환 endpoint로 가리켜 사용.

# KRX 정보데이터시스템(data.krx.co.kr) 회원 자격증명.
# F&G 오실레이터의 실제 입력(V-KOSPI200 변동성지수 / 코스피200 옵션 ATM /
# 국채선물 5Y·10Y)은 KRX MDC 가 회원 로그인을 요구하므로 필요.
# 무료 가입: https://data.krx.co.kr → 우상단 회원가입
KRX_ID=your-krx-member-id
KRX_PW=your-krx-password

# 금감원 DART OpenAPI 키 — AI 데이터 브리핑의 공시 이벤트 수집용.
# 무료 발급: https://opendart.fss.or.kr → 인증키 신청 (즉시 발급, 일 20,000건)
# 없으면 브리핑은 자체 시그널만으로 생성되고 공시 섹션은 스킵된다.
DART_API_KEY=your-dart-api-key
